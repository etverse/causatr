  NA_real_
)
fit <- causat(dose_data, outcome = "Y", treatment = "dose",
              confounders = ~ L0, confounders_tv = ~ L,
              id = "id", time = "t", estimator = "gcomp",
              treatment_form = ~ factor(dose))
contrast(fit, interventions = list(
  cap = cap_escalation(1),
  natural = NULL
), ci_method = "bootstrap")
