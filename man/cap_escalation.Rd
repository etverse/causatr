set.seed(1)
n <- 400L
tau <- 3L
dose_data <- data.frame(
  id = rep(seq_len(n), each = tau),
  t = rep(seq_len(tau), times = n),
  L0 = rep(rnorm(n), each = tau),
  L = rnorm(n * tau)
)
dose_data$dose <- pmin(2L, rpois(n * tau, lambda = 0.8))
dose_data$Y <- ifelse(
  dose_data$t == tau,
